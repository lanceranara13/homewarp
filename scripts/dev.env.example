# Copy to scripts/dev.env (it is not committed) and fill in.
# scripts/dev.sh and lab/real-vps-spike.sh read it.

# The ssh host that builds and tests run on (a name from ~/.ssh/config, or user@address).
HOME_SSH=homelab

# The folder on that machine that holds src/ and data/. Absolute.
REMOTE=/home/you/homewarp

# A VPS to try the Gate on, an ssh host. Only `dev.sh vps` and the spike script use it.
# VPS_SSH=vps
