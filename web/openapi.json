{
  "openapi": "3.1.0",
  "info": {
    "title": "Homewarp",
    "description": "The Homewarp panel's API.",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/gate": {
      "get": {
        "summary": "The Gate, how the tunnel to it is doing, and every port it forwards. The\none request the Network page needs, and the one the Gate's pill asks again.",
        "operationId": "get_gate",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateView"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Starts connecting a VPS: makes the keys of a tunnel to it and answers with\nthe one command to run there. The command counts for a quarter of an hour.\nCore dials the VPS from now until then, and the tunnel is up within a few\nseconds of the command being run; asking for the Gate again shows it.",
        "operationId": "enrol_gate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewGate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The command is ready, and the VPS is awaited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateView"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "A Gate is connected already.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "The address or the port will not do.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Forgets the Gate and takes home's end of the tunnel down. Servers go back\nto being reached on the home network only. The VPS keeps its Gate program\nuntil `homewarp-gate leave` is run there.",
        "operationId": "disconnect_gate",
        "responses": {
          "204": {
            "description": "There is no Gate now."
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gate/check": {
      "post": {
        "summary": "Finds out again whether servers see their players' own addresses, and puts\nthe Gate in the mode that works. It takes a few seconds, during which new\nconnections may be turned away.",
        "operationId": "check_gate",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateView"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "No Gate is connected, or it cannot be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Wrong username or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out."
          }
        }
      }
    },
    "/api/v1/servers": {
      "get": {
        "summary": "Every server, by name. The one request the Servers page needs.",
        "operationId": "list_servers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServerSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Makes a server from a template, then installs and starts it. The answer\ncomes at once; the install goes on, and the server's console shows it.",
        "operationId": "create_server",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewServer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "The name or the port belongs to another server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "Something asked for will not do.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "503": {
            "description": "Homewarp cannot reach Docker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}": {
      "get": {
        "summary": "One server, with its state and the end of its console. A page that stays\nopen asks again to follow both.",
        "operationId": "get_server",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The server's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Changes what a server is made of. It has to be stopped first, and what was\nchanged counts from its next start.",
        "operationId": "change_server",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The server's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "The server is running, or the name or the port belongs to another.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "Something asked for will not do.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Removes a server that is not running, with its files.",
        "operationId": "remove_server",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The server's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The server and its files are gone."
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "The server is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/command": {
      "post": {
        "summary": "Types one line into the console of a server that is starting or running.",
        "operationId": "command_server",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The server's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The line is on its way to the server."
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "The server is not running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "That is not one line.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "503": {
            "description": "Homewarp cannot reach Docker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/servers/{id}/power": {
      "post": {
        "summary": "Starts, stops or kills a server, or installs one again whose install failed.\nThe answer comes once the request is on its way, not once it is carried out.",
        "operationId": "power_server",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The server's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PowerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The server has been asked."
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "The state the server is in rules that out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "503": {
            "description": "Homewarp cannot reach Docker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "summary": "Who is signed in, and whether setup is still to do. The one request a page\nneeds before it can paint.",
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "summary": "Creates the first account and signs it in. Works once.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The account exists and is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "403": {
            "description": "The setup code is wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "There is an account already.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "The username or password will not do.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/templates": {
      "get": {
        "summary": "Every template, by name. The one request the Templates page needs.",
        "operationId": "list_templates",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TemplateSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Reads an egg and keeps it as a template.",
        "operationId": "import_template",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "There is a template of that name already.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "422": {
            "description": "This is not an egg Homewarp can read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/templates/{id}": {
      "get": {
        "operationId": "get_template",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The template's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such template.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "remove_template",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The template's id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The template is gone."
          },
          "401": {
            "description": "Nobody is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "404": {
            "description": "There is no such template.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          },
          "409": {
            "description": "A server is made from it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandRequest": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "One line, as it would be typed into the server's console."
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "type": "object",
            "description": "Where things stand. It comes first, and again for a page that has\nfallen too far behind to be caught up line by line.",
            "required": [
              "state",
              "first",
              "lines",
              "kind"
            ],
            "properties": {
              "first": {
                "type": "integer",
                "format": "int64",
                "description": "The number of the first of `lines`.",
                "minimum": 0
              },
              "kind": {
                "type": "string",
                "enum": [
                  "snapshot"
                ]
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "$ref": "#/components/schemas/State"
              },
              "usage": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Usage"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "One more line of the console.",
            "required": [
              "number",
              "text",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "line"
                ]
              },
              "number": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "state",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "state"
                ]
              },
              "state": {
                "$ref": "#/components/schemas/State"
              }
            }
          },
          {
            "type": "object",
            "description": "About once a second while the server runs.",
            "required": [
              "usage",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "usage"
                ]
              },
              "usage": {
                "$ref": "#/components/schemas/Usage"
              }
            }
          }
        ],
        "description": "What a page that follows a server is sent, over its socket."
      },
      "ExtraPort": {
        "type": "object",
        "description": "A further port of a server: voice chat, say, or the port it is queried on.",
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "protocol": {
            "$ref": "#/components/schemas/PortProtocol"
          }
        }
      },
      "ForwardedPort": {
        "type": "object",
        "description": "A port of a server, which a connected Gate forwards.",
        "required": [
          "port",
          "protocol",
          "server_id",
          "server"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "protocol": {
            "$ref": "#/components/schemas/PortProtocol"
          },
          "server": {
            "type": "string",
            "description": "The server's name."
          },
          "server_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GateState": {
        "type": "string",
        "description": "Where a Gate stands.",
        "enum": [
          "none",
          "waiting",
          "expired",
          "connected"
        ]
      },
      "GateView": {
        "type": "object",
        "description": "The Gate, and how the tunnel to it is doing.",
        "required": [
          "state",
          "reachable",
          "player_addresses",
          "received_bytes",
          "sent_bytes",
          "ports"
        ],
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ],
            "description": "The VPS's public address: what players type."
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "description": "While a VPS is awaited: what to run on it, as root."
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "When that command stops counting, in Unix seconds."
          },
          "handshake_age_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "How long ago the Gate last heard from home over the tunnel.",
            "minimum": 0
          },
          "latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "How long the way to the Gate and back takes, in milliseconds.",
            "minimum": 0
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the check of that found, where it needs saying."
          },
          "player_addresses": {
            "$ref": "#/components/schemas/PlayerAddresses",
            "description": "Whether servers see their players' own addresses."
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForwardedPort"
            },
            "description": "Every port of every server: what a connected Gate forwards."
          },
          "problem": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the Gate could not be reached, when it could not."
          },
          "reachable": {
            "type": "boolean",
            "description": "Whether the Gate answered through the tunnel when it was last asked."
          },
          "received_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Through the tunnel since the Gate last set it up, as the Gate counts.",
            "minimum": 0
          },
          "sent_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/GateState"
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "The version of the Gate program on the VPS."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ImportRequest": {
        "type": "object",
        "required": [
          "egg"
        ],
        "properties": {
          "egg": {
            "type": "string",
            "description": "The egg as a panel exports it: JSON or YAML."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NewGate": {
        "type": "object",
        "description": "What it takes to start connecting a VPS.",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "description": "The VPS's public IPv4 address, or a name for it."
          },
          "wg_port": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The UDP port its WireGuard is to listen on. 51820 if none is given.",
            "minimum": 0
          }
        }
      },
      "NewServer": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ServerSettings"
          },
          {
            "type": "object",
            "required": [
              "template_id"
            ],
            "properties": {
              "template_id": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ]
      },
      "PlayerAddresses": {
        "type": "string",
        "description": "Whether servers see their players' own addresses, as the self-probe found it.",
        "enum": [
          "preserved",
          "hidden",
          "unchecked"
        ]
      },
      "PortProtocol": {
        "type": "string",
        "description": "Which protocols a port is published for at home and forwarded for by the Gate.",
        "enum": [
          "tcp",
          "udp",
          "both"
        ]
      },
      "Power": {
        "type": "string",
        "description": "What a person can ask of a server.",
        "enum": [
          "start",
          "stop",
          "kill",
          "install"
        ]
      },
      "PowerRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Power"
          }
        }
      },
      "ProblemBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A sentence fit to show to the person using the panel."
          }
        }
      },
      "Server": {
        "type": "object",
        "description": "A server in full, with the end of its console.",
        "required": [
          "id",
          "created_at",
          "name",
          "template_id",
          "template",
          "image",
          "memory_mb",
          "cpu_percent",
          "port",
          "protocol",
          "ports",
          "state",
          "console",
          "variables",
          "eula"
        ],
        "properties": {
          "console": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The last lines of its console: the install first, then what the server prints."
          },
          "cpu_percent": {
            "type": "integer",
            "format": "int64",
            "description": "100 is one core. 0 is no limit."
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "When it was made, in Unix seconds."
          },
          "eula": {
            "type": "boolean",
            "description": "Whether the game's EULA was agreed to for it."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "image": {
            "type": "string"
          },
          "memory_mb": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int64",
            "description": "Where players reach it, on the home machine and on a connected VPS."
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtraPort"
            },
            "description": "The further ports it has."
          },
          "protocol": {
            "$ref": "#/components/schemas/PortProtocol",
            "description": "Which protocols that port is open for."
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "template": {
            "type": "string",
            "description": "The name of the template it was made from."
          },
          "template_id": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "object",
            "description": "The value of each of the template's variables, by the name the server sees.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ServerSettings": {
        "type": "object",
        "description": "What a server is made of that can still be changed once it is made.",
        "required": [
          "name",
          "memory_mb",
          "port"
        ],
        "properties": {
          "cpu_percent": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "100 is one core. Nothing, or 0, is no limit.",
            "minimum": 0
          },
          "eula": {
            "type": "boolean",
            "description": "Whoever asks agrees to the EULA of the game, for a game that has one."
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "description": "One of the template's images. Its first, if none is named."
          },
          "memory_mb": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32",
            "description": "Published on the home machine, and forwarded by a connected VPS.",
            "minimum": 0
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtraPort"
            },
            "description": "Further ports, each published and forwarded as the first is."
          },
          "protocol": {
            "$ref": "#/components/schemas/PortProtocol",
            "description": "Which protocols that port is open for. Both, if none is named."
          },
          "variables": {
            "type": "object",
            "description": "Values for the template's variables, by the name the server sees. One\nthat is not given takes the template's default.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ServerSummary": {
        "type": "object",
        "description": "A server as the Servers page shows it.",
        "required": [
          "id",
          "name",
          "template",
          "state",
          "port",
          "memory_mb"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "memory_mb": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int64",
            "description": "Where players reach it on the home machine."
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "template": {
            "type": "string",
            "description": "The name of the template it was made from."
          }
        }
      },
      "Session": {
        "type": "object",
        "description": "Everything the web interface needs to decide what to show first.",
        "required": [
          "setup_required",
          "version"
        ],
        "properties": {
          "setup_required": {
            "type": "boolean",
            "description": "True until the first account has been created."
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/User",
                "description": "Who is signed in, if anyone."
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "code",
          "username",
          "password"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code Homewarp wrote to its log when it started."
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "State": {
        "type": "string",
        "description": "What a server is doing.",
        "enum": [
          "installing",
          "install_failed",
          "offline",
          "starting",
          "running",
          "stopping",
          "crashed"
        ]
      },
      "StopBy": {
        "type": "string",
        "enum": [
          "command",
          "signal"
        ]
      },
      "Template": {
        "type": "object",
        "description": "A template in full: everything Homewarp will do on its word.",
        "required": [
          "id",
          "created_at",
          "name",
          "description",
          "images",
          "startup",
          "done",
          "stop",
          "config_files",
          "variables",
          "features"
        ],
        "properties": {
          "config_files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The files patched in a server's directory before every start."
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "When it was imported, in Unix seconds."
          },
          "description": {
            "type": "string"
          },
          "done": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A server has started once its console prints any of these."
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateImage"
            },
            "description": "The first is the one a new server runs in unless another is picked."
          },
          "install": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TemplateInstall",
                "description": "What runs once, before a server's first start. Not every template has it."
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "startup": {
            "type": "string",
            "description": "The command that starts a server, with `{{NAME}}` where a variable goes."
          },
          "stop": {
            "$ref": "#/components/schemas/TemplateStop"
          },
          "variables": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateVariable"
            }
          }
        }
      },
      "TemplateImage": {
        "type": "object",
        "required": [
          "label",
          "image"
        ],
        "properties": {
          "image": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "TemplateInstall": {
        "type": "object",
        "required": [
          "image",
          "entrypoint",
          "script"
        ],
        "properties": {
          "entrypoint": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        }
      },
      "TemplateStop": {
        "type": "object",
        "description": "How a server is asked to shut down.",
        "required": [
          "by",
          "value"
        ],
        "properties": {
          "by": {
            "$ref": "#/components/schemas/StopBy"
          },
          "value": {
            "type": "string",
            "description": "The command typed into the console, or the name of the signal sent."
          }
        }
      },
      "TemplateSummary": {
        "type": "object",
        "description": "A template as the gallery shows it.",
        "required": [
          "id",
          "name",
          "description",
          "image"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "image": {
            "type": "string",
            "description": "The image a new server runs in unless another is picked."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TemplateVariable": {
        "type": "object",
        "required": [
          "name",
          "description",
          "env",
          "default",
          "rules",
          "user_viewable",
          "user_editable"
        ],
        "properties": {
          "default": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "env": {
            "type": "string",
            "description": "The environment variable the server sees."
          },
          "name": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Laravel-style validation rules, one per entry."
          },
          "user_editable": {
            "type": "boolean"
          },
          "user_viewable": {
            "type": "boolean"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "How much of the machine a running server is using.",
        "required": [
          "cpu_percent",
          "memory_bytes",
          "memory_limit_bytes"
        ],
        "properties": {
          "cpu_percent": {
            "type": "number",
            "format": "float",
            "description": "Of one core: 150 is a core and a half."
          },
          "memory_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "memory_limit_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "The most it may use before it is stopped.",
            "minimum": 0
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          }
        }
      }
    }
  }
}
